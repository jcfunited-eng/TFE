+// Two geom poses in their lowest common body frame. World frame uses cached
+// geometry exactly. Only the reached ancestry is recalculated in other frames.
+int mj_geomPairFrame(const mjModel* m, const mjData* d, int g1, int g2,
+                     mjtNum pos[6], mjtNum mat[18]) {
+  if (g1 < 0 || g1 >= m->ngeom || g2 < 0 || g2 >= m->ngeom) {
+    mjERROR("invalid geometry index for pair frame");
+  }
+  int bodies[2] = {m->geom_bodyid[g1], m->geom_bodyid[g2]};
+  int a = bodies[0], b = bodies[1];
+  // Compiled anatomy orders every parent before its descendants.
+  while (a != b) {
+    if (a > b) a = m->body_parentid[a];
+    else b = m->body_parentid[b];
+  }
+  int ancestor = a;
+  if (!ancestor) {
+    mju_copy3(pos, d->geom_xpos+3*g1);
+    mju_copy3(pos+3, d->geom_xpos+3*g2);
+    mju_copy(mat, d->geom_xmat+9*g1, 9);
+    mju_copy(mat+9, d->geom_xmat+9*g2, 9);
+    return 0;
+  }
+
+  int lengths[2] = {0, 0};
+  for (int side = 0; side < 2; side++) {
+    for (int i = bodies[side]; i != ancestor; i = m->body_parentid[i]) {
+      lengths[side]++;
+    }
+  }
+  mjData* scratch = (mjData*)d;  // native transient stack, not retained state
+  mj_markStack(scratch);
+  int count = lengths[0] + lengths[1];
+  int* chain = count ? mj_stackAllocInt(scratch, count) : NULL;
+  int geoms[2] = {g1, g2};
+  int offset = 0;
+  for (int side = 0; side < 2; side++) {
+    int cursor = offset;
+    for (int i = bodies[side]; i != ancestor; i = m->body_parentid[i]) {
+      chain[cursor++] = i;
+    }
+    mjtNum bp[3] = {0}, bq[4] = {1, 0, 0, 0};
+    mjtNum bm[9] = {1, 0, 0, 0, 1, 0, 0, 0, 1};
+    while (cursor > offset) {
+      mjtNum nextpos[3], nextquat[4];
+      bodyKinematics(m, d, chain[--cursor], bp, bq, bm, nextpos, nextquat, NULL);
+      mju_copy3(bp, nextpos);
+      mju_copy4(bq, nextquat);
+      mju_quat2Mat(bm, bq);
+    }
+    int g = geoms[side], body = bodies[side];
+    mjtNum ip[3], im[9];
+    mjtSameFrame sf = m->geom_sameframe[g];
+    if (sf == mjSAMEFRAME_INERTIA || sf == mjSAMEFRAME_INERTIAROT) {
+      mj_local2Frame(ip, im, m->body_ipos+3*body, m->body_iquat+4*body,
+                     mjSAMEFRAME_NONE, bp, bq, bm, NULL, NULL);
+    }
+    mj_local2Frame(pos+3*side, mat+9*side, m->geom_pos+3*g, m->geom_quat+4*g,
+                   sf, bp, bq, bm, ip, im);
+    offset += lengths[side];
+  }
+  mj_freeStack(scratch);
+  return ancestor;
+}
