+// Quaternion scale is representation, not physical stretch: R(q) = H(q)/(q.q).
+void mju_quat2Mat(mjtNum res[9], const mjtNum quat[4]) {
+  mjtNum largest = 0;
+  for (int i = 0; i < 4; i++) {
+    if (!isfinite(quat[i])) {
+      mju_error("non-finite quaternion cannot define rigid geometry");
+    }
+    mjtNum magnitude = fabs(quat[i]);
+    if (magnitude > largest) {
+      largest = magnitude;
+    }
+  }
+  if (largest == 0) {
+    mju_error("zero quaternion cannot define rigid geometry");
+  }
+
+  // Exact identity orientation, including nonunit and negative scalar lifts.
+  if (quat[1] == 0 && quat[2] == 0 && quat[3] == 0) {
+    res[0] = res[4] = res[8] = 1;
+    res[1] = res[2] = res[3] = res[5] = res[6] = res[7] = 0;
+    return;
+  }
+
+  // Scale by a binary exponent, avoiding norm overflow/underflow.
+  // At least one component is in [.5, 1), so sum of squares is in [.25, 4).
+  int exponent;
+  frexp(largest, &exponent);
+  mjtNum q[4];
+  for (int i = 0; i < 4; i++) {
+    q[i] = ldexp(quat[i], -exponent);
+  }
+  const mjtNum q00 = q[0]*q[0], q01 = q[0]*q[1];
+  const mjtNum q02 = q[0]*q[2], q03 = q[0]*q[3];
+  const mjtNum q11 = q[1]*q[1], q12 = q[1]*q[2], q13 = q[1]*q[3];
+  const mjtNum q22 = q[2]*q[2], q23 = q[2]*q[3], q33 = q[3]*q[3];
+  const mjtNum square = q00 + q11 + q22 + q33;
+
+  res[0] = (q00 + q11 - q22 - q33)/square;
+  res[4] = (q00 - q11 + q22 - q33)/square;
+  res[8] = (q00 - q11 - q22 + q33)/square;
+  res[1] = 2*(q12 - q03)/square;
+  res[2] = 2*(q13 + q02)/square;
+  res[3] = 2*(q12 + q03)/square;
+  res[5] = 2*(q23 - q01)/square;
+  res[6] = 2*(q13 - q02)/square;
+  res[7] = 2*(q23 + q01)/square;
+}
 
