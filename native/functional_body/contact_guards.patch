+// Record actual native candidate predicates; never affect admission.
+static void boxGuard(mjBoxGuards* guards, int kind, int a, int b, int c, int d,
+                     mjtNum depth, mjtNum separation_squared) {
+  if (!guards) return;
+  if (guards->count == mjMAXCONPAIR) {
+    guards->overflow = 1;
+    return;
+  }
+  mjBoxGuard* row = guards->guard + guards->count++;
+  row->kind = kind;
+  row->feature[0] = a;
+  row->feature[1] = b;
+  row->feature[2] = c;
+  row->feature[3] = d;
+  row->depth = depth;
+  row->separation_squared = separation_squared;
+}
+
+// One implementation serves normal collisions and optional observation.
+int mjc_BoxBox(const mjModel* M, const mjData* D, mjContact* con,
+               int g1, int g2, mjtNum margin) {
+  return mjc_BoxBoxGuards(M, D, con, g1, g2, margin, NULL);
+}
