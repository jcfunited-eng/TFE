+// Optional read-only box predicates, produced by the same collision function.
+// No callback, retained state, force alteration, or geometry matching policy.
+// Identity = ordered geom pair + branch[] + kind + feature[].
+// Compare identities, not row offsets; missing/changing features are unavailable.
+// kind: 1 face depth; 2 edge-line depth; 3 edge-corner; 4 edge-vertex.
+// feature: face {generator,a,b,c}; line {line,axis,sign,0};
+//          corner {corner,clamp-u,clamp-v,(prior-corner-mask<<1)|has-lines};
+//          vertex {vertex,clamp-x,clamp-y,eligibility-regime}.
+// Face generators: 1 line/plane intersection, 2 reference corner, 3 incident
+// vertex. Indices are native generating features, not output contact indices.
+// depth is the native signed length BEFORE rejection (metres).
+// Kinds 1/2 reject when depth>margin. Kinds 3/4 reject only when depth>0
+// AND separation_squared>margin_squared (square metres).
+// branch: SAT code, face corner, face axis mask, edge cle1,cle2,in,
+//         edge ax1,ax2,pax1,pax2,clface; unused entries are -1.
+typedef struct mjBoxGuard_ {
+  int kind;
+  int feature[4];
+  mjtNum depth;
+  mjtNum separation_squared;
+} mjBoxGuard;
+typedef struct mjBoxGuards_ {
+  int branch[11];
+  int count;
+  int overflow;
+  mjtNum margin;
+  mjtNum margin_squared;
+  mjBoxGuard guard[mjMAXCONPAIR];
+} mjBoxGuards;
+MJAPI int mjc_BoxBoxGuards(const mjModel* m, const mjData* d,
+                          mjContact* con, int g1, int g2, mjtNum margin,
+                          mjBoxGuards* guards);
+
 #ifdef __cplusplus
 }
 #endif
