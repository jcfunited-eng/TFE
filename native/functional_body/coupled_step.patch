+// Only the discrete step adds hB. Physical inertia and its normalization stay intact.
+static mjtNum stepDiagonal(const mjCGContext* ctx, int i) {
+  return ctx->step_shift ? ctx->step_shift[ctx->step_dofs ? ctx->step_dofs[i] : i] : 0;
