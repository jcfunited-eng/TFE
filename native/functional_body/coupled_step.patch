+static void metricMultiply(const mjCGContext* ctx, mjtNum* out, const mjtNum* in) {
+  mju_mulSymVecSparse(out, ctx->M, in, ctx->nv,
+                      ctx->M_rownnz, ctx->M_rowadr, ctx->M_colind);
+  if (ctx->step_shift) {
+    for (int i=0; i < ctx->nv; i++) out[i] += stepDiagonal(ctx, i)*in[i];
+  }
+}
+
+
+// Called after EVERY construction/reconstruction, never on an already shifted factor.
+static void addStepDiagonal(mjCGContext* ctx) {
+  if (!ctx->step_shift) return;
+  for (int i=0; i < ctx->nv; i++) {
+    if (ctx->is_sparse) {
+      int begin = ctx->H_rowadr[i], end = begin + ctx->H_rownnz[i];
+      int j = begin;
+      while (j < end && ctx->H_colind[j] < i) j++;
+      if (j == end || ctx->H_colind[j] != i) mjERROR("step Hessian missing diagonal");
+      ctx->H[j] += stepDiagonal(ctx, i);
+    } else {
+      ctx->L[i*(ctx->nv+1)] += stepDiagonal(ctx, i);
+    }
+  }
+}
