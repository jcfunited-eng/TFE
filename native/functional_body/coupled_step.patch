+// Implicit midpoint in the existing coupled contact/bearing law.
+// Trial stages are scratch. mj_advance is reached once, only on true residual convergence.
+static void midpointStep(const mjModel* m, mjData* d) {
+  if (m->opt.solver != mjSOL_NEWTON || mjDISABLED(mjDSBL_DAMPER) ||
+      m->opt.noslip_iterations || mjENABLED(mjENBL_FWDINV) || m->opt.viscosity || m->opt.density) {
+    mjERROR("coupled body step requires Newton, active bearings, zero no-slip/fluid, no forward-inverse comparison");
+  }
+  if (m->na || m->nplugin || m->nmocap || m->nflex ||
+      mjcb_control || mjcb_passive || mjcb_contactfilter || mjcb_sensor ||
+      mjcb_act_dyn || mjcb_act_gain || mjcb_act_bias) {
+    mjERROR("coupled body midpoint excludes activation, plugins, mocap, flex and callbacks");
+  }
+  for (int i=0; i < m->ntendon; i++) {
+    if (m->tendon_damping[i]) mjERROR("coupled body step excludes tendon damping");
+  }
+  int nv = m->nv;
+  mjtNum h = m->opt.timestep, t0 = d->time;
+  mjtNum normalization = m->stat.meaninertia * mjMAX(1, nv);
+  if (!isfinite(h) || h <= 0 || !isfinite(t0) || !isfinite(t0+h) || t0+h <= t0 ||
+      !isfinite(normalization) || normalization <= 0 || m->opt.iterations <= 0 || m->opt.ls_iterations <= 0 ||
+      !isfinite(m->opt.tolerance) || m->opt.tolerance <= 0) {
+    mjERROR("coupled body midpoint requires finite clock, inertia and convergence bounds");
+  }
+
+  mj_markStack(d);
+  mjtNum* q0 = mjSTACKALLOC(d, m->nq, mjtNum);
+  mjtNum* v0 = mjSTACKALLOC(d, nv, mjtNum);
+  mjtNum* vm = mjSTACKALLOC(d, nv, mjtNum);
+  mjtNum* a = mjSTACKALLOC(d, nv, mjtNum);
+  mjtNum* shift = mjSTACKALLOC(d, nv, mjtNum);
+  mjtNum* direction = mjSTACKALLOC(d, nv, mjtNum);
+  mjtNum* trial = mjSTACKALLOC(d, nv, mjtNum);
+  mjtNum* residual = mjSTACKALLOC(d, nv, mjtNum);
+  mju_copy(q0, d->qpos, m->nq);
+  mju_copy(v0, d->qvel, nv);
+  mju_copy(a, d->qacc_warmstart, nv);
+  for (int i=0; i < nv; i++) shift[i] = 0.5*h*m->dof_damping[i];
+  int valid = finiteVector(q0, m->nq) && finiteVector(v0, nv) &&
+              finiteVector(a, nv) && finiteVector(shift, nv);
+  for (int i=0; i < nv; i++) valid = valid && m->dof_damping[i] >= 0;
+  int converged = 0;
+
+  // At most 1+iterations*ls_iterations physical stage evaluations and
+  // iterations bounded native Newton proposals per reached island.
+  mjtNum defect = 0;
+  if (valid) valid = midpointResidual(m, d, q0, v0, t0, h, a, vm, residual, &defect);
+  if (valid && defect <= m->opt.tolerance) converged = 1;
+  for (int iteration=0; valid && !converged && iteration < m->opt.iterations; iteration++) {
+    // Existing frozen-stage proposal: M+hB/2 with F_nonbearing-B*v0.
+    for (int i=0; i < nv; i++) {
+      d->qfrc_smooth[i] += m->dof_damping[i]*(vm[i]-v0[i]);
+    }
+    if (!finiteVector(d->qfrc_smooth, nv)) {
+      valid = 0;
+      break;
+    }
+    solveAccelerationMetric(m, d, shift);
+    fwdConstraintMetric(m, d, shift);
+    mju_sub(direction, d->qacc, a, nv);
+    valid = finiteVector(direction, nv);
+    if (!valid) break;
+
+    // Binary subdivision globalizes the algebraic proposal; it is not
+    // physical damping and introduces no material coefficient.
+    int accepted = 0;
+    mjtNum alpha = 1;
+    for (int search=0; valid && search < m->opt.ls_iterations; search++, alpha *= 0.5) {
+      mju_addScl(trial, a, direction, alpha, nv);
+      int distinct = 0;
+      for (int i=0; i < nv; i++) distinct = distinct || trial[i] != a[i];
+      valid = distinct && finiteVector(trial, nv);
+      if (!valid) break;
+      mjtNum trial_defect = 0;
+      valid = midpointResidual(m, d, q0, v0, t0, h, trial, vm, residual, &trial_defect);
+      if (!valid) break;
+      if (trial_defect <= m->opt.tolerance || trial_defect < defect) {
+        mju_copy(a, trial, nv);
+        defect = trial_defect;
+        accepted = 1;
+        converged = defect <= m->opt.tolerance;
+        break;  // retain this full physical stage and its forces
+      }
+    }
+    if (!accepted) valid = 0;
+  }
+
+  if (converged) {
+    if (mjENABLED(mjENBL_ENERGY)) {
+      mj_energyPos(m, d);
+      mj_energyVel(m, d);
+    }
+    mj_sensorPos(m, d);
+    mj_sensorVel(m, d);
+    mj_sensorAcc(m, d);
+    mj_checkAcc(m, d);
+  }
+  mju_copy(d->qpos, q0, m->nq);
+  mju_copy(d->qvel, v0, nv);
+  d->time = t0;
+  if (!converged) {
+    mj_freeStack(d);
+    mjERROR("coupled body midpoint residual did not converge; no successor");
+  }
+  mj_advance(m, d, d->act_dot, a, vm);
+  mj_freeStack(d);
+}
