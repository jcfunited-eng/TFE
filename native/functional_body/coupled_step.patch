+// Finite algebraic quantities only; no new physical tolerance or clipping.
+static int finiteVector(const mjtNum* values, int count) {
+  for (int i=0; i < count; i++) {
+    if (!isfinite(values[i])) return 0;
+  }
+  return 1;
+}
+
+
+// Rebuild and evaluate the physical midpoint equation at one algebraic trial.
+// Rejected trials remain scratch; no elapsed body time or work is committed here.
+static int midpointResidual(const mjModel* m, mjData* d,
+                            const mjtNum* q0, const mjtNum* v0,
+                            mjtNum t0, mjtNum h, const mjtNum* a,
+                            mjtNum* vm, mjtNum* residual, mjtNum* defect) {
+  int nv = m->nv;
+  mju_addScl(vm, v0, a, 0.5*h, nv);
+  mju_copy(d->qpos, q0, m->nq);
+  mju_copy(d->qvel, vm, nv);
+  mj_integratePos(m, d->qpos, vm, 0.5*h);
+  d->time = t0 + 0.5*h;
+  if (!finiteVector(d->qpos, m->nq) || !finiteVector(vm, nv)) return 0;
+
+  // Contact membership, inertia, impedance and reference are never frozen
+  // across residual evaluations, including rejected line-search trials.
+  mj_fwdPosition(m, d);
+  mj_fwdVelocity(m, d);
+  mj_fwdActuation(m, d);
+  smoothForce(m, d);
+  if (!finiteVector(d->M, m->nC) || !finiteVector(d->qfrc_smooth, nv) ||
+      !finiteVector(d->efc_J, mj_isSparse(m) ? d->nJ : d->nefc*nv) ||
+      !finiteVector(d->efc_R, d->nefc) || !finiteVector(d->efc_D, d->nefc) ||
+      !finiteVector(d->efc_aref, d->nefc)) return 0;
+
+  mju_copy(d->qacc, a, nv);
+  if (d->nefc) {
+    mj_markStack(d);
+    mjtNum* jar = mjSTACKALLOC(d, d->nefc, mjtNum);
+    mj_mulJacVec(m, d, jar, a);
+    mju_subFrom(jar, d->efc_aref, d->nefc);
+    int valid = finiteVector(jar, d->nefc);
+    if (valid) mj_constraintUpdate(m, d, jar, NULL, 0);
+    mj_freeStack(d);
+    if (!valid) return 0;
+  } else {
+    mju_zero(d->qfrc_constraint, nv);
+  }
+  mj_mulM(m, d, residual, a);
+  mju_subFrom(residual, d->qfrc_smooth, nv);
+  mju_subFrom(residual, d->qfrc_constraint, nv);
+  *defect = mju_norm(residual, nv) / (m->stat.meaninertia * mjMAX(1, nv));
+  return finiteVector(d->efc_force, d->nefc) &&
+         finiteVector(d->qfrc_constraint, nv) && finiteVector(residual, nv) &&
+         isfinite(*defect);
+}
