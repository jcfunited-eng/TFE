+// Solve the existing physical or shifted inertia operator on the supplied RHS.
+static void solveAccelerationMetric(const mjModel* m, mjData* d, const mjtNum* shift) {
+  int nv = m->nv;
+  if (!shift) {
+    mj_solveM(m, d, d->qacc_smooth, d->qfrc_smooth, 1);
+    return;
+  }
+
+  // Step metric H=M+hB/2; physical M and its factor remain untouched.
+  mju_copy(d->qH, d->M, m->nC);
+  for (int i=0; i < nv; i++) {
+    d->qH[m->M_rowadr[i] + m->M_rownnz[i] - 1] += shift[i];
+  }
+  mj_factorI(d->qH, d->qHDiagInv, nv, m->M_rownnz, m->M_rowadr, m->M_colind);
+  mju_copy(d->qacc_smooth, d->qfrc_smooth, nv);
+  mj_solveLD(d->qacc_smooth, d->qH, d->qHDiagInv, nv, 1,
+             m->M_rownnz, m->M_rowadr, m->M_colind);
+}
