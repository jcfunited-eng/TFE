+def test_transition_scope_owns_pending_handler_and_completion() -> None:
+    owner = AutonomousExperienceDriver(
+        authority_key=KEY,
+        max_records=8,
+        max_state_bytes=64 * 1024,
+    )
+    transition_active = threading.Event()
+    scope_states = []
+
+    @contextlib.contextmanager
+    def transition_scope():
+        entered = owner.status()
+        scope_states.append((
+            "entered",
+            entered["pending"],
+            entered["in_flight_work_receipt_sha256"],
+            entered["completed"],
+        ))
+        transition_active.set()
+        try:
+            yield
+        finally:
+            exiting = owner.status()
+            scope_states.append((
+                "exiting",
+                exiting["pending"],
+                exiting["in_flight_work_receipt_sha256"],
+                exiting["completed"],
+            ))
+            transition_active.clear()
+
+    def handle(_work):
+        assert transition_active.is_set()
+        return ()
+
+    owner.start(handle, transition_scope=transition_scope)
+    work = owner.issue_work(
+        kind="internal_dream",
+        source_receipt_sha256=_h("scoped-dream"),
+    )
+    owner.admit(work)
+    for _ in range(200):
+        if owner.status()["completed"] == 1:
+            break
+        time.sleep(0.005)
+    owner.quiesce(1)
+
+    assert scope_states == [
+        ("entered", 1, None, 0),
+        ("exiting", 0, None, 1),
+    ]
+
