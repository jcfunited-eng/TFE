+/// Only external input preparation is parallel: each row reads its own living
+/// predecessor and these immutable plans. Recovery and cohort commit follow
+/// the ordered result reduction at the caller, unchanged.
+fn prepare_reached_receptor_rows<'a, T: Send>(
+    anatomy: &ReachedCohortAnatomy,
+    catalysts: &[(usize, Box<[u128]>)],
+    perspective_at: impl Fn(usize) -> Result<JointNeuronPerspective<'a>, JointNeuronBoundaryError>,
+    prepare_row: impl Fn(
+        usize,
+        Result<JointNeuronPerspective<'a>, JointNeuronBoundaryError>,
+        Result<&PreparedPsiKrimelackDelivery, NeuronPhysicalError>,
+    ) -> Result<T, FormationError> + Sync,
+) -> Result<Vec<Result<T, FormationError>>, FormationError> {
+    let mut perspectives = Vec::new();
+    let mut results = Vec::new();
+    perspectives.try_reserve_exact(catalysts.len())
+        .map_err(|_| FormationError::ArithmeticOverflow)?;
+    results.try_reserve_exact(catalysts.len())
+        .map_err(|_| FormationError::ArithmeticOverflow)?;
+    let mut mathloom = BTreeMap::new();
+    let mut psi = BTreeMap::new();
+    let mut first_plan_error = None;
+    for (row, (resident_index, _)) in catalysts.iter().enumerate() {
+        let perspective = perspective_at(row);
+        let prepared = perspective.clone().map_err(NeuronPhysicalError::from)
+            .and_then(|perspective| {
+                prepare_reached_gate_psi_plan(
+                    &anatomy.neuron_anatomies()[*resident_index], perspective,
+                    &mut mathloom, &mut psi,
+                ).map(|_| ())
+            });
+        perspectives.push(perspective);
+        if let Err(error) = prepared {
+            first_plan_error = Some((row, error));
+            break;
+        }
+    }
+    let prepare = |(row, perspective): (usize, &Result<JointNeuronPerspective<'a>, JointNeuronBoundaryError>)| {
+        let prepared = match first_plan_error.as_ref() {
+            Some((failed_row, error)) if row == *failed_row => Err(error.clone()),
+            _ => psi.get(&anatomy.neuron_anatomies()[catalysts[row].0].heavy_anatomy_identity())
+                .ok_or(NeuronPhysicalError::AnatomyMismatch),
+        };
+        // The row consumes a plan error only after its original earlier checks.
+        prepare_row(row, perspective.clone(), prepared)
+    };
+    if perspectives.len() <= 1 {
+        results.extend(perspectives.iter().enumerate().map(prepare));
+    } else {
+        perspectives.par_iter().enumerate().map(prepare).collect_into_vec(&mut results);
+    }
+    Ok(results)
+}
