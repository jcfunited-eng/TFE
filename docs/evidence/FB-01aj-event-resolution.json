    "scope": "diagnostic launch wrapper only; no live authority; existing clock alarm not certified cleared",
    "code": "def require_live_body_health(snapshot):\n    # Diagnostic launch preflight only; never an organism or cognitive gate.\n    if not isinstance(snapshot, dict):\n        raise ValueError(\"missing health snapshot\")\n    service = snapshot.get(\"service\", {})\n    observation = snapshot.get(\"observation\", {})\n    if not isinstance(service, dict) or not isinstance(observation, dict):\n        raise ValueError(\"unavailable health components\")\n    tasks = service.get(\"tasks\", [])\n    if service.get(\"counts\") != [1, 1, 0] or not isinstance(tasks, list) or len(tasks) != 1:\n        raise ValueError(\"production is draining, unavailable, or not single-task\")\n    task = tasks[0]\n    if not isinstance(task, dict) or task.get(\"status\") != \"RUNNING\" or task.get(\"health\") != \"HEALTHY\":\n        raise ValueError(\"production task is not running and healthy\")\n    digests = task.get(\"digests\", [])\n    if not digests or any(not isinstance(d, str) or not d.startswith(\"sha256:\") or len(d) != 71 for d in digests):\n        raise ValueError(\"immutable image evidence unavailable\")\n    if observation.get(\"available\") is not True or observation.get(\"durability_blocked\") is not False:\n        raise ValueError(\"observation unavailable or durability blocked\")\n    if any(k not in observation or observation[k] is not None for k in (\"checkpoint_error\", \"cleanup_error\")):\n        raise ValueError(\"checkpoint or cleanup error unavailable/non-null\")\n    if not observation.get(\"identity\") or not isinstance(observation.get(\"live_tick\"), int):\n        raise ValueError(\"organism identity or tick unavailable\")\n",
