+    def test_refused_new_effort_keeps_actual_work_without_executed_trial(self):
+        organism, world = pair()
+        FunctionalPhysicalLoop().settle(organism, world, UNATTENDED)
+        before = world.observation_snapshot()
+        decision = organism.decide(sensed_from(world))
+        self.assertTrue(decision.act.startswith("effort:"))
+        rejected_tick = organism.live_organism_tick
+        # Controlled actuator-boundary fault only. Real decision, world,
+        # mechanics, energy debit, commit and successor sensing are unchanged.
+        rejected = replace(decision, commands=(
+            AnatomicalEffortCommand((("unmounted-test-actuator", 0.),), 250000),))
+        basal = organism.prepare_body_energy(positive_motor_work_j=0., intake_micrograms=0)
+        prepared, applied, refusal, refused = _apply(world, rejected, before,
+            motor_supply=(organism.available_motor_work_j, basal.basal_nanojoules))
+        self.assertEqual(applied, "body")
+        self.assertIsNotNone(refusal)
+        self.assertEqual(refusal, refused[-1])
+        self.assertGreater(prepared.native_work.positive_motor_work_j, 0.)
+        self.assertEqual(prepared.execution_receipt.elapsed_nanoseconds, 250000000)
+        energy = organism.prepare_body_energy(
+            positive_motor_work_j=prepared.native_work.positive_motor_work_j, intake_micrograms=0)
+        with world.prepared_action_visibility_transaction(prepared):
+            organism.commit(rejected, applied_action=applied, refusal=refusal,
+                intake_micrograms=0, spoke=None, heard_profile=None, self_profile=None,
+                tick_now=rejected_tick, body_energy=energy)
+            world.commit_prepared_action(prepared)
+        self.assertEqual(organism.reserve_energy_nanojoules,
+                         energy.before_nanojoules-energy.basal_nanojoules-energy.work_nanojoules)
+        after = world.observation_snapshot()
+        ports = organism._body_interface.sensors
+        for port, old, new in zip(ports, before.native.self_feedback.sensors, after.native.self_feedback.sensors):
+            if port[1] == "actuator_force":
+                self.assertEqual(old, new)  # unchanged real settings continue
+        pending = organism._state["pending_transition"]
+        self.assertEqual(pending["applied_action"], "body")
+        self.assertEqual(pending["refusal"], refusal)
+        self.assertTrue(organism._state["pending_act"]["refused"])
+        world.thermal_observation()
+        organism.decide(sensed_from(world))
+        self.assertNotIn(f"motor:{rejected_tick}", organism._state["moments"])
