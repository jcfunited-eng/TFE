+"""FB-01aj standalone real ordinary-loop proof; no pytest/conftest/network.
+
+A declared zero-gravity bench isolates effort/reafference, not walking or a
+mature production body. The separate floor case uses actual contact mechanics.
+Migration fixtures and repeated measured-window cost probes are explicitly
+controlled checks, never fabricated learning evidence.
+"""
+from dataclasses import replace
+import copy
+import json
+import hashlib
+import math
+import resource
+import time
+import unittest
+
+from dsf_ai_service.guala_functional_loop import FunctionalPhysicalLoop, _apply
+from dsf_ai_service.guala_functional_organism import (
+    FunctionalOrganism, Sensed, STREAMS, CHOICE_STREAMS, KERNEL_WINDOW,
+    MOMENT_RECORD_CAPACITY, MEANING_CAPACITY, choice_key, coarse_key,
+)
+from dsf_ai_service.lean_actor import PhysicalOccurrence
+from dsf_ai_service.substrate.embodiment_world import (
+    AnatomicalEffortCommand,
+)
+from dsf_ai_service.substrate.functional_body_native import NativeBody
+from dsf_ai_service.substrate.functional_body_interface import local_trial_evidence
+from dsf_ai_service.substrate.thermally_coupled_embodiment_world import ThermallyCoupledEmbodimentWorldAuthority
+from test_functional_body_optical_sources import KEY, world as optical_world, declaration, mount
+from test_functional_body_world import world as thermal_world
+from test_functional_body_anatomy import model_xml, LIMITS
+
+
+UNATTENDED = PhysicalOccurrence("unattended", None)
+
+
+def ordinary_world():
+    source = optical_world()._state.world
+    thermal = thermal_world(thermal=True, measured_core=True)._thermal_anatomy
+    return ThermallyCoupledEmbodimentWorldAuthority(
+        authority_key=KEY, receipt_capacity=2, thermal_anatomy=thermal,
+        initial_objects=source.objects, regions=source.regions)
+
+
+def pair():
+    world = ordinary_world()
+    mount(world, declaration())
+    organism = FunctionalOrganism.genesis(identity="offline-ordinary-body-proof", organism_tick=100)
+    return organism, world
+
+
+def sensed_from(world, *, interface=True, feedback=True):
+    observation = world.observation_snapshot()
+    return Sensed(observation, (0,) * 57600, "world", None, None,
+        body_interface=world.native_body_interface(expected_revision=observation.revision) if interface else None,
+        body_feedback=observation.native.self_feedback if feedback else None)
+
+
+class OrdinaryBodyInterfaceTests(unittest.TestCase):
+    def test_ordinary_motor_return_energy_trial_and_paired_cold_successor(self):
+        organism, world = pair()
+        loop = FunctionalPhysicalLoop()
+        original_energy = organism.reserve_energy_nanojoules
+        before = world.observation_snapshot()
+        start = time.perf_counter()
+        first = loop.settle(organism, world, UNATTENDED)
+        elapsed = time.perf_counter() - start
+        self.assertTrue(first.observation["her_act"].startswith("effort:"))
+        self.assertIsNone(first.observation["world_action_refusal"])
+        self.assertEqual(first.observation["requested_world_action"], first.observation["her_act"])
+        self.assertEqual(first.native_interval_count, 1)
+        after = world.observation_snapshot()
+        self.assertEqual(world._state.recent_applied_receipts[-1].elapsed_nanoseconds, 250000000)
+        # This declared bench advances 250 steps of binary64 0.001 s.
+        # Bound accumulation error independently of the exact causal receipt.
+        self.assertLessEqual(abs(after.native.time_s-before.native.time_s-.25),
+                             250 * math.ulp(before.native.time_s+.25))
+        self.assertIsNone(first.observation["requested_root_motion"])
+        self.assertEqual(organism.live_organism_tick, 101)
+        self.assertNotEqual(before.native.self_feedback.sensors, after.native.self_feedback.sensors)
+        energy = first.observation["body_energy_nanojoules"]
+        self.assertGreater(energy["motor_work"], 0)
+        self.assertEqual(energy["before"], original_energy)
+        self.assertEqual(energy["after"], original_energy-energy["basal"]-energy["motor_work"])
+        self.assertEqual(energy["after"], organism.reserve_energy_nanojoules)
+        world.thermal_observation()  # coupled custody remains valid
+        self.assertEqual(first.observation["embodiment"]["native_body_axes"], [])
+        self.assertIsNotNone(first.observation["native_self_feedback"])
+        first_action = first.observation["her_act"]
+        expected_measurements = organism._body_interface.measure(after.native.self_feedback)
+        body_bytes, world_bytes = organism.encoded(), world.encoded_snapshot()
+        restored = FunctionalOrganism.restore(body_bytes)
+        fresh_world = ordinary_world()
+        fresh_world.restore_encoded(world_bytes)
+        self.assertEqual(restored.encoded(), body_bytes)
+        self.assertEqual(fresh_world.encoded_snapshot(), world_bytes)
+        a = loop.settle(organism, world, UNATTENDED)
+        b = FunctionalPhysicalLoop().settle(restored, fresh_world, UNATTENDED)
+        self.assertEqual(organism.encoded(), restored.encoded())
+        self.assertEqual(world.encoded_snapshot(), fresh_world.encoded_snapshot())
+        self.assertEqual(a.observation, b.observation)
+        for name, measured in expected_measurements.items():
+            self.assertEqual(organism._state["streams"][name][-1], measured)
+        self.assertTrue(any(first_action in entry["acts"] for entry in organism._state["acts"].values()))
+        pending = organism._state["pending_transition"]
+        compact = json.loads(pending["pre_key"])[-1]
+        interface = organism._body_interface
+        self.assertEqual(compact[0], interface.namespace)
+        expanded = (
