new file mode 100644
index 000000000..e7b49389a
--- /dev/null
+++ b/dsf_ai_service/substrate/functional_body_interface.py
@@ -0,0 +1,165 @@
+"""Anatomical input coordinates and direct effort options, not a controller.
+
+The functional runtime's existing per-stream learner is preserved. Signed SI
+measurements use two nonnegative coordinates because its L0 input is positive.
+Contact loads are integrated per anatomical surface, sign-separated before
+summation; this is NOT a skin texture or full pressure-distribution model.
+Raw localized contacts remain available as the actual trial evidence.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+import hashlib
+import json
+import math
+
+
+# Kind -> (SI unit family, dimension). Joint/actuator unit comes from hinge/slide.
+_KINDS = {
+    "joint_position": (("rad", "m"), 1),
+    "joint_velocity": (("rad/s", "m/s"), 1),
+    "actuator_force": (("N m", "N"), 1),
+    "specific_force": (("m/s^2",), 3),
+    "angular_velocity": (("rad/s",), 3),
+}
+
+
+@dataclass(frozen=True)
+class BodyInterface:
+    # name, kind, anatomical address, SI unit, number of components
+    sensors: tuple[tuple[str, str, str, str, int], ...]
+    # named collision surface and its local link frame
+    surfaces: tuple[tuple[str, str], ...]
+    # motor name, joint address, SI unit, actual lower/upper physical capacity
+    motors: tuple[tuple[str, str, str, float, float], ...]
+    channels: tuple[str, ...] = field(init=False, compare=False)
+    namespace: str = field(init=False, compare=False)
+
+    def __post_init__(self):
+        for roster in (self.sensors, self.surfaces, self.motors):
+            if len({row[0] for row in roster}) != len(roster):
+                raise ValueError("duplicate anatomical port")
+            if any(not isinstance(row[0], str) or not row[0] for row in roster):
+                raise ValueError("named anatomical ports required")
+        if not self.sensors or not self.motors:
+            raise ValueError("instrumented and actuated body required")
+        for name, kind, address, unit, dimension in self.sensors:
+            specification = _KINDS.get(kind)
+            if (specification is None or unit not in specification[0]
+                    or type(dimension) is not int or dimension != specification[1]
+                    or not isinstance(address, str) or not address):
+                raise ValueError("sensor must retain compiled kind, address and SI unit")
+        for surface, frame in self.surfaces:
+            if not isinstance(frame, str) or not frame:
+                raise ValueError("contact surface requires its local anatomical frame")
+        for name, address, unit, low, high in self.motors:
+            if (not isinstance(address, str) or not address or unit not in ("N", "N m")
+                    or type(low) is not float or type(high) is not float
+                    or not math.isfinite(low) or not math.isfinite(high)
+                    or not low < high or not low <= 0 <= high):
+                raise ValueError("direct motor capacity must admit zero effort")
+        count = sum(row[4] for row in self.sensors) + 6 * len(self.surfaces)
+        object.__setattr__(self, "channels", tuple(
+            f"body:{i}:{sign}" for i in range(count) for sign in ("+", "-")))
+        encoded = json.dumps(self.record(), sort_keys=True, separators=(",", ":"),
+                             allow_nan=False).encode()
+        object.__setattr__(self, "namespace", hashlib.sha256(encoded).hexdigest())
+
+    def record(self):
+        return {"schema": "guala.anatomical-interface.v1",
+                "sensors": [list(row) for row in self.sensors],
+                "surfaces": [list(row) for row in self.surfaces],
+                "motors": [list(row) for row in self.motors]}
+
+    @classmethod
+    def restore(cls, record):
+        if (not isinstance(record, dict)
+                or set(record) != {"schema", "sensors", "surfaces", "motors"}
+                or record["schema"] != "guala.anatomical-interface.v1"):
+            raise ValueError("anatomical interface schema changed")
+        result = cls(tuple(tuple(r) for r in record["sensors"]),
+                     tuple(tuple(r) for r in record["surfaces"]),
+                     tuple(tuple(r) for r in record["motors"]))
+        if result.record() != record:
+            raise ValueError("noncanonical anatomical interface")
+        return result
+
+    def measure(self, feedback):
+        """Actual local evidence only. No poses, scene identity, or inferred load.
+
+        Each native SI unit is one coordinate unit; the unchanged kernel floor
+        is applied later. Component sign is split BEFORE surface integration,
+        so opposing forces do not disappear in a zero net resultant.
+        """
+        if feedback is None or not math.isfinite(feedback.time_s):
+            raise ValueError("mounted body feedback is unavailable")
+        if len(feedback.sensors) != len(self.sensors):
+            raise ValueError("mounted body sensor roster changed")
+        coordinates = []
+        for port, (name, values) in zip(self.sensors, feedback.sensors):
+            if name != port[0] or len(values) != port[4]:
+                raise ValueError("body reading differs from admitted anatomical port")
+            for value in values:
+                if not math.isfinite(value):
+                    raise ValueError("nonfinite measured body quantity")
+                coordinates.extend((max(0., float(value)), max(0., -float(value))))
+        surface_rows = {name: i for i, (name, frame) in enumerate(self.surfaces)}
+        loads = [[0.] * 12 for _ in self.surfaces]
+        for contact in feedback.contacts:
+            row = surface_rows.get(contact.surface)
+            if row is None:
+                raise ValueError("contact has no anatomical surface")
+            r, f, c = contact.position_m, contact.force_n, contact.couple_nm
+            if any(len(v) != 3 or not all(math.isfinite(x) for x in v)
+                   for v in (r, f, c)):
+                raise ValueError("invalid local physical contact")
+            # Contact couple is at r, so transport it to the shared link origin.
+            moment = (r[1]*f[2]-r[2]*f[1]+c[0],
+                      r[2]*f[0]-r[0]*f[2]+c[1],
+                      r[0]*f[1]-r[1]*f[0]+c[2])
+            if not all(math.isfinite(value) for value in moment):
+                raise ValueError("body contact moment overflow")
+            for j, value in enumerate((*f, *moment)):
+                loads[row][2*j] += max(0., float(value))
+                loads[row][2*j+1] += max(0., -float(value))
+        coordinates.extend(x for load in loads for x in load)
+        if not all(math.isfinite(x) for x in coordinates):
+            raise ValueError("body load coordinate overflow")
+        return dict(zip(self.channels, coordinates))
+
+    def effort_options(self, duration_microseconds):
+        """Mechanical vocabulary only; the unchanged learner selects an option.
+
+        Each command changes ONE setting; all other settings persist physically,
+        so independently selected settings can recruit several joints together.
+        This supplies no gait, force servo or learned coordination claim.
+        """
+        from .embodiment_world import AnatomicalEffortCommand
+        out = []
+        for name, joint, unit, low, high in self.motors:
+            for value in dict.fromkeys((low, 0., high)):
+                identity = "effort:" + json.dumps((name, value.hex()), separators=(",", ":"))
+                out.append((identity, f"{joint}: {value.hex()} {unit}",
+                    (AnatomicalEffortCommand(((name, value),), duration_microseconds),),
+                    None, None))
+        return out
+
+
+def local_trial_evidence(feedback, interface: BodyInterface | None = None):
+    """Actual local sample, with stable anatomy encoded once for retained trials.
+
+    Public observation keeps labels. Stored trials use the immutable roster
+    namespace, sensor arrays in roster order, and anatomical surface ordinals.
+    These are NOT ordinals of the changing contact list. Time is carried by
+    the enclosing transition; no world identity/pose or hidden ctrl is added.
+    """
+    if feedback is None:
+        raise ValueError("body trial is missing its measured evidence")
+    if interface is None:
+        return [[name, list(values)] for name, values in feedback.sensors], [
+            [c.surface, list(c.position_m), list(c.force_n), list(c.couple_nm)]
+            for c in feedback.contacts]
+    surfaces = {name: ordinal for ordinal, (name, frame) in enumerate(interface.surfaces)}
+    return (interface.namespace, [list(values) for name, values in feedback.sensors], [
+        [surfaces[c.surface], list(c.position_m), list(c.force_n), list(c.couple_nm)]
+        for c in feedback.contacts])
