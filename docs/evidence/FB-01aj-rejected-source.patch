+    def test_historical_keys_survive_anatomical_admission_and_restart(self):
+        # Controlled codec fixture ONLY, not claimed as an experienced action.
+        organism, world = pair()
+        regimes = "_" * len(STREAMS)
+        key = choice_key(regimes)
+        organism._state["acts"][key] = {"acts": {"step": [1, .25]}, "tick": 99, "visits": 1, "regimes": regimes}
+        organism._state["familiarity"][key] = [1, 99]
+        prior = copy.deepcopy(organism._state["acts"])
+        organism._bind_body_interface(sensed_from(world))
+        organism.migrate()
+        self.assertEqual(organism._state["acts"], prior)
+        self.assertEqual(choice_key(regimes, organism._body_interface), key)
+        self.assertEqual(coarse_key(regimes, organism._body_interface), coarse_key(regimes))
+        encoded = organism.encoded()
+        cold = FunctionalOrganism.restore(encoded)
+        self.assertEqual(cold.encoded(), encoded)
+        self.assertEqual(cold._state["acts"], prior)
+        extended = "_" * len(organism._stream_names)
+        self.assertNotEqual(choice_key(extended, organism._body_interface), key)
+        # Reference the original key expression as a bounded test oracle only.
+        # The corrected runtime must emit identical namespace and hash bytes.
+        streams = organism._stream_names
+        varied = "".join("DSM_"[i % 4] for i in range(len(streams)))
+        old_letters = "".join(varied[streams.index(name)]
+                              for name in CHOICE_STREAMS + organism._body_interface.channels
+                              if name in streams)
+        old_encoded = organism._body_interface.namespace + ":" + " ".join(old_letters)
+        self.assertEqual(choice_key(varied, organism._body_interface),
+                         hashlib.sha256(old_encoded.encode()).hexdigest()[:16])
+        shifted = extended[:-1] + "D"
+        self.assertNotEqual(choice_key(extended, organism._body_interface),
+                            choice_key(shifted, organism._body_interface))
