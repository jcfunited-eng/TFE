  "scope": "Authenticated archived results only; no simulation or runtime change. Group events do not identify same-solve row impulses.",
  "analysis_script": "import json,base64,zlib,hashlib,math\nfrom pathlib import Path\npath=Path('docs/evidence/FB-01aj-load-release.json')\ndata=json.loads(path.read_text())\nrows={}\nfor entry in data['measurements']:\n    raw=zlib.decompress(base64.b64decode(entry['payload_zlib_base64']))\n    assert len(raw)==entry['raw_bytes'] and hashlib.sha256(raw).hexdigest()==entry['raw_sha256']\n    row=json.loads(raw)\n    if row['name']=='guala/torso/roll/effort':\n        rows[row['step_us']]=row\nsummary=[]\nfor step,row in sorted(rows.items()):\n    report=row['phases'][0]['report']\n    events=report['active_constraint_group_events']\n    contact=next(e for e in events if any(k[0]>=5 for k in e['active']))\n    summary.append(dict(step_us=step,first_constraint=events[1],first_contact=contact,\n        joint_group_changes_before_contact=sum(e['elapsed_us']<contact['elapsed_us'] for e in events)-1,\n        solver_at_cap_samples=report['solver_at_cap_samples'],max_solver_iterations=report['max_solver_iterations']))\ncomparisons=[]\nfor coarse,fine in ((100,50),(50,25)):\n    a=rows[coarse]['phases'][0]['report']['trajectory_every_10ms']\n    b=rows[fine]['phases'][0]['report']['trajectory_every_10ms']\n    for x,y in zip(a,b):\n        assert x['elapsed_us']==y['elapsed_us']\n        if x['elapsed_us']>40000: break\n        q=[abs(u-v) for u,v in zip(x['qpos'][7:],y['qpos'][7:])]\n        v=[abs(u-w) for u,w in zip(x['qvel'][6:],y['qvel'][6:])]\n        comparisons.append(dict(step_us=[coarse,fine],time_us=x['elapsed_us'],\n            max_hinge_delta_rad=max(q),hinge_qpos_index=7+q.index(max(q)),\n            max_joint_rate_delta_rad_s=max(v),rate_dof_index=6+v.index(max(v)),\n            root_displacement_delta_m=math.dist(x['qpos'][:3],y['qpos'][:3])))\nprint(json.dumps(dict(schema='guala.functional-body.archived-first-contact.v1',\n    source=str(path),source_sha256=hashlib.sha256(path.read_bytes()).hexdigest(),\n    summaries=summary,comparisons=comparisons,\n    scope='Authenticated archived results only; no simulation or runtime change. Group events do not identify same-solve row impulses.')))\n",
  "interpretation": "The first shared contact group occurs at 21.5ms. Hinge differences before20ms decrease under refinement; marked velocity differences exist by30ms. This localizes a measurement window, not the responsible contact impulse or a root-cause verdict. Solver iteration exhaustion is excluded in the archived initial load."
