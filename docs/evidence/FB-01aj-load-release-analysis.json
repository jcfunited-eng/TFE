  "localization_script": "import base64,json,zlib\nfrom pathlib import Path\nimport numpy as np\ndata=json.loads(Path(\"docs/evidence/FB-01aj-load-release.json\").read_text())\nrows=[json.loads(zlib.decompress(base64.b64decode(r[\"payload_zlib_base64\"]))) for r in data[\"measurements\"]]\nmeta=json.loads(Path(\"docs/evidence/FB-01aj-fixed-response-loads.json\").read_text())[\"full\"]\nqn={a:n for a,n in zip(meta[\"qpos_addresses\"],meta[\"joint_names\"])}\nvn={a:n for a,n in zip(meta[\"dof_addresses\"],meta[\"joint_names\"])}\nout=[]\nfor name in sorted({r[\"name\"] for r in rows}):\n b={r[\"step_us\"]:r for r in rows if r[\"name\"]==name}\n for coarse,fine in ((100,50),(50,25)):\n  positions=[];velocities=[]\n  for ph,(p,q) in enumerate(zip(b[coarse][\"phases\"],b[fine][\"phases\"])):\n   for x,y in zip(p[\"report\"][\"trajectory_every_10ms\"],q[\"report\"][\"trajectory_every_10ms\"]):\n    du=np.abs(np.asarray(x[\"qpos\"])[7:]-np.asarray(y[\"qpos\"])[7:])\n    dv=np.abs(np.asarray(x[\"qvel\"])[6:]-np.asarray(y[\"qvel\"])[6:])\n    j=int(np.argmax(du))+7;k=int(np.argmax(dv))+6\n    positions.append((float(du[j-7]),qn[j],p[\"phase\"],x[\"elapsed_us\"],x[\"qpos\"][j],y[\"qpos\"][j]))\n    velocities.append((float(dv[k-6]),vn[k],p[\"phase\"],x[\"elapsed_us\"],x[\"qvel\"][k],y[\"qvel\"][k]))\n  out.append(dict(load=name,steps=[coarse,fine],angle_peak=max(positions),velocity_peak=max(velocities)))\nprint(json.dumps(out,indent=2))\n",
