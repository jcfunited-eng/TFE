  "source": "FB-01aj-load-release.json",
  "analysis_script": "import base64, hashlib, json, math, zlib\nfrom pathlib import Path\nimport numpy as np\nd=json.loads(Path(\"docs/evidence/FB-01aj-load-release.json\").read_text())\nrows=[]\nfor rec in d[\"measurements\"]:\n raw=zlib.decompress(base64.b64decode(rec[\"payload_zlib_base64\"]))\n assert len(raw)==rec[\"raw_bytes\"] and hashlib.sha256(raw).hexdigest()==rec[\"raw_sha256\"]\n r=json.loads(raw); rows.append(r)\n print(json.dumps({\"name\":r[\"name\"],\"h_us\":r[\"step_us\"],\"completed\":r[\"completed\"],\n  \"peak_rss_kib\":r[\"max_rss_kib\"],\"net_constraint_j\":r[\"net_constraint_work_j\"],\n  \"phases\":[{\"phase\":p[\"phase\"],\"K_j\":p[\"kinetic_j\"],\n    \"force_rows\":p[\"terminal_nonzero_constraint_force_rows\"],\n    \"contact_min_m\":min(p[\"terminal_contact_separations_m\"],default=0.),\n    \"hinge_max_rad\":max(p[\"terminal_joint_overruns_rad\"],default=0.),\n    \"constraint_j\":p[\"report\"][\"discrete_update\"][\"work_j\"][\"constraint\"],\n    \"physical_balance_j\":p[\"report\"][\"discrete_update\"][\"physical_balance_with_discrete_constraint_j\"],\n    \"cold_seconds\":p[\"cold_advance_seconds\"],\"state_bytes\":p[\"state_bytes\"]}\n    for p in r[\"phases\"]]},allow_nan=False))\nfor name in sorted({r[\"name\"] for r in rows}):\n by={r[\"step_us\"]:r for r in rows if r[\"name\"]==name}\n for a,b in ((100,50),(50,25)):\n  maxima=dict(root_position_m=0.,root_orientation_rad=0.,hinge_position_rad=0.,\n    root_linear_speed_m_s=0.,root_angular_speed_rad_s=0.,joint_speed_rad_s=0.)\n  for p,q in zip(by[a][\"phases\"],by[b][\"phases\"]):\n   for x,y in zip(p[\"report\"][\"trajectory_every_10ms\"],q[\"report\"][\"trajectory_every_10ms\"]):\n    assert x[\"elapsed_us\"]==y[\"elapsed_us\"]\n    u,v=np.array(x[\"qpos\"]),np.array(y[\"qpos\"])\n    su,sv=np.array(x[\"qvel\"]),np.array(y[\"qvel\"])\n    quatdot=abs(float(np.dot(u[3:7],v[3:7])/(np.linalg.norm(u[3:7])*np.linalg.norm(v[3:7]))))\n    values=dict(root_position_m=float(np.linalg.norm(u[:3]-v[:3])),\n      root_orientation_rad=2*math.acos(min(1.,quatdot)),\n      hinge_position_rad=float(np.max(np.abs(u[7:]-v[7:]))),\n      root_linear_speed_m_s=float(np.linalg.norm(su[:3]-sv[:3])),\n      root_angular_speed_rad_s=float(np.linalg.norm(su[3:6]-sv[3:6])),\n      joint_speed_rad_s=float(np.max(np.abs(su[6:]-sv[6:]))))\n    for k,w in values.items(): maxima[k]=max(maxima[k],w)\n  print(json.dumps({\"comparison\":name,\"h_us\":[a,b],\"max_sampled_differences\":maxima}))\nprint(json.dumps({\"summary\":{\"cases\":len(rows),\"intervals\":sum(len(r[\"phases\"]) for r in rows),\n \"all_completed\":all(r[\"completed\"] for r in rows),\n \"all_cold_exact\":all(p[\"cold_successor_exact\"] for r in rows for p in r[\"phases\"]),\n \"state_sizes\":sorted({p[\"state_bytes\"] for r in rows for p in r[\"phases\"]}),\n \"max_cycle_absolute_energy_closure_j\":max(r[\"sum_absolute_equation_closure_j\"] for r in rows),\n \"max_peak_rss_kib\":max(r[\"max_rss_kib\"] for r in rows)}}))\n",
