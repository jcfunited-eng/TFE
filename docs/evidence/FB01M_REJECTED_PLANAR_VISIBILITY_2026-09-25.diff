+"""Bounded float64 planar visibility, not a complete native-scene renderer.
+
+Input patches must come from authoritative planar surface geometry. A patch is
+origin + u*axis[0] + v*axis[1]; its material chart stays in (u,v), not eye pixels.
+Curved geometry, shading and material sampling are NOT approximated here.
+No physical state is changed, retained or inferred from rendering addresses.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+
+from .functional_body_optics import surface_cone
+
+
+@dataclass(frozen=True)
+class PlanarPatch:
+    origin: np.ndarray
+    axes: np.ndarray
+    boundary_uv: np.ndarray
+
+    def points(self, uv):
+        return self.origin + uv @ self.axes
+
+
+@dataclass(frozen=True)
+class VisibleRegion:
+    patch_index: int
+    boundary_uv: np.ndarray
+
+
+def _packed(a, shape):
+    return (isinstance(a, np.ndarray) and a.dtype == np.dtype(np.float64)
+            and a.shape == shape and np.isfinite(a).all())
+
+
+def _area2(uv):
+    # Translation before the shoelace sum avoids cancellation from UV origin.
+    relative = uv - uv[0]
+    following = np.roll(relative, -1, axis=0)
+    area = float(np.sum(relative[:, 0] * following[:, 1]
+                        - relative[:, 1] * following[:, 0]))
+    if not np.isfinite(relative).all() or not np.isfinite(area):
+        raise ValueError("nonfinite planar area")
+    return area
+
+
+def visible_planar_regions(patches, *, max_vertices, max_work):
+    """Return convex, non-overlapping visible pieces of opaque planar patches.
+
+    Only the forward hemisphere x>=0 is delivered. max_vertices bounds all
+    vertices in each prepared/output/active pool (total storage O(max_vertices));
+    max_work bounds accumulated
+    vertex geometry evaluations, including convexity and broad-phase checks. Limits are
+    resource declarations, not perceptual cutoffs. A refusal returns no result.
+    Array inputs are borrowed read-only during this call; output arrays own their
+    storage. No ordering by object centre, distance score or material is used.
+    Coincident overlapping surfaces refuse because their radiance is ambiguous.
+    """
+    if (type(max_vertices) is not int or max_vertices <= 0
+            or type(max_work) is not int or max_work <= 0):
+        raise ValueError("positive integer visibility work/residency limits required")
+    if not isinstance(patches, tuple):
+        raise ValueError("finite tuple of planar patches required")
+    count = 0
+    for patch in patches:
+        if (not isinstance(patch, PlanarPatch)
+                or not _packed(patch.origin, (3,)) or not _packed(patch.axes, (2, 3))
+                or not isinstance(patch.boundary_uv, np.ndarray)
+                or patch.boundary_uv.ndim != 2 or patch.boundary_uv.shape[1] != 2
+                or not _packed(patch.boundary_uv, patch.boundary_uv.shape)
+                or len(patch.boundary_uv) < 3):
+            raise ValueError("finite packed planar geometry required")
+        count += len(patch.boundary_uv)
+        if count > max_vertices:
+            raise ValueError("input patch vertices exceed visibility residency")
+    work = 0
+
+    def charge(n):
+        nonlocal work
+        work += n
+        if work > max_work:
+            raise ValueError("visibility work exhausted")
+
+    def keep(uv):
+        if len(uv) < 3 or _area2(uv) == 0:
+            return None
+        # Remove only exactly redundant UV corners, not small optical features.
+        # Coordinates on the surviving edges retain the same material chart.
+        while len(uv) >= 3:
+            charge(len(uv))
+            before, after = uv - np.roll(uv, 1, axis=0), np.roll(uv, -1, axis=0) - uv
+            turns = before[:, 0] * after[:, 1] - before[:, 1] * after[:, 0]
+            if not np.isfinite(turns).all() or not np.isfinite(before).all() or not np.isfinite(after).all():
+                raise ValueError("nonfinite planar corner geometry")
+            redundant = np.flatnonzero(turns == 0)
+            if not len(redundant):
+                break
+            # Retain the middle point only if the path reverses along the edge;
+            # reversal is invalid ordering, not a redundant convex corner.
+            i = int(redundant[0])
+            if np.any((before[i] > 0) & (after[i] < 0)) or np.any((before[i] < 0) & (after[i] > 0)):
+                raise ValueError("planar boundary reverses along an edge")
+            uv = np.delete(uv, i, axis=0)
+        if len(uv) < 3 or _area2(uv) == 0:
+            return None
+        return uv
+
+    def clip(uv, patch, normal):
+        if uv is None:
+            return None
+        charge(len(uv))
+        # Signed plane is evaluated at the same attached coordinates used by
+        # material sampling. Interpolation cannot move a cut off its face.
+        coefficient = patch.axes @ normal
+        offset = patch.origin @ normal
+        sides = uv @ coefficient + offset
+        if not np.isfinite(sides).all():
+            raise ValueError("nonfinite optical clipping geometry")
+        if np.all(sides >= 0):
+            return uv
+        if np.all(sides <= 0):
+            return None
+        if len(uv) + 1 > max_vertices:
+            raise ValueError("clipping scratch exceeds vertex residency")
+        vertices = []
+        for i, point in enumerate(uv):
+            previous, before, after = uv[i - 1], sides[i - 1], sides[i]
+            if (before < 0 < after) or (after < 0 < before):
+                scale = max(abs(before), abs(after))
+                b, a = before / scale, after / scale
+                weight = b / (b - a)
+                intersection = (1. - weight) * previous + weight * point
+                if not np.isfinite(intersection).all():
+                    raise ValueError("nonfinite clipping intersection")
+                vertices.append(intersection)
+            if after >= 0:
+                vertices.append(point)
+        return keep(np.asarray(vertices, dtype=np.float64))
+
+    # Prepare each projected convex cone once, not once per receptor or pair.
+    prepared = []
+    prepared_vertices = 0
+    for patch in patches:
+        uv = keep(patch.boundary_uv)
+        if uv is None:
+            raise ValueError("degenerate planar boundary")
+        winding = _area2(uv)
+        if winding == 0:
+            raise ValueError("degenerate planar boundary")
+        for i in range(len(uv)):
+            charge(len(uv))
+            edge, delta = uv[(i + 1) % len(uv)] - uv[i], uv - uv[i]
+            sides = (edge[0] * delta[:, 1] - edge[1] * delta[:, 0]) * np.sign(winding)
+            if not np.isfinite(sides).all() or not np.isfinite(delta).all() or not np.isfinite(edge).all():
+                raise ValueError("nonfinite convexity geometry")
+            if np.any(sides < 0) or np.all(edge == 0):
+                raise ValueError("planar boundary must be ordered convex")
+        normal = np.cross(patch.axes[0], patch.axes[1])
+        scale = float(np.max(np.abs(normal)))
+        if not np.isfinite(normal).all() or scale == 0:
+            raise ValueError("degenerate planar coordinate frame")
+        normal = normal / scale
+        distance = float(normal @ patch.origin)
+        if not np.isfinite(distance):
+            raise ValueError("nonfinite planar distance")
+        if distance < 0:
+            normal, distance = -normal, -distance
+        front = clip(uv, patch, np.array((1., 0., 0.)))
+        if front is None or distance == 0:
+            prepared.append(None)
+            continue
+        prepared_vertices += len(front)
+        if prepared_vertices > max_vertices:
+            raise ValueError("prepared geometry exceeds vertex residency")
+        charge(len(front) * (len(front) + 1))
+        cone = surface_cone(patch.points(front))
+        prepared.append((front, cone, normal, distance))
+
+    answer = []
+    answer_vertices = 0
+    for index, source in enumerate(prepared):
+        if source is None:
+            continue
+        patch = patches[index]
+        front, _cone, normal, distance = source
+        regions = [front]
+        for other_index, blocker in enumerate(prepared):
+            if other_index == index or blocker is None:
+                continue
+            _front_b, cone_b, normal_b, distance_b = blocker
+            depth = distance * normal_b - distance_b * normal
+            if not np.isfinite(depth).all():
+                raise ValueError("nonfinite depth-order geometry")
+            coincident = not np.any(depth)
+            planes = cone_b if coincident else np.vstack((cone_b, depth))
+            successor = []
+            resident = answer_vertices + sum(len(p) for p in regions)
+            for region in regions:
+                # Any separating plane disproves overlap; no split is needed.
+                points = patch.points(region)
+                separated = False
+                for plane in planes:
+                    charge(len(region))
+                    if np.all(points @ plane <= 0):
+                        separated = True
+                        break
+                if separated:
+                    successor.append(region)
+                    continue
+                inside, pieces, piece_vertices = region, [], 0
+                for plane in planes:
+                    outside = clip(inside, patch, -plane)
+                    if outside is not None:
+                        piece_vertices += len(outside)
+                        if resident - len(region) + piece_vertices > max_vertices:
+                            raise ValueError("visible fragments exceed residency")
+                        pieces.append(outside)
+                    inside = clip(inside, patch, plane)
+                    if inside is None:
+                        break
+                if coincident and inside is not None:
+                    raise ValueError("overlapping coplanar optical surfaces are ambiguous")
+                resident += sum(len(p) for p in pieces) - len(region)
+                if resident > max_vertices:
+                    raise ValueError("visible fragments exceed residency")
+                successor.extend(pieces)
+            regions = successor
+            if not regions:
+                break
+        for region in regions:
+            charge(len(region))
+            points = patch.points(region)
+            if not np.isfinite(points).all():
+                raise ValueError("nonfinite visible surface coordinates")
+            # A representable UV sliver can collapse when converted to the
+            # actual float64 physical coordinates (e.g. 1e-17m at x=2m).
+            # Remove exactly coincident consecutive points, never a small
+            # feature threshold. Fewer than three points has zero optical area.
+            distinct = np.any(points != np.roll(points, 1, axis=0), axis=1)
+            region = region[distinct]
+            if len(region) < 3:
+                continue
+            owned = region.copy()
+            owned.setflags(write=False)
+            answer.append(VisibleRegion(index, owned))
+            answer_vertices += len(owned)
+            if answer_vertices > max_vertices:
+                raise ValueError("visible output exceeds residency")
+    return tuple(answer)

