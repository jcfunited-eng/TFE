+"""Offline planar visibility/material-chart proofs; no live world or API writes."""
+import math
+import time
+import unittest
+import xml.etree.ElementTree as ET
+
+import numpy as np
+
+from dsf_ai_service.substrate.functional_body_native import NativeBody
+from dsf_ai_service.substrate.functional_body_optics import aperture_solid_angles, surface_cone
+from dsf_ai_service.substrate.functional_body_visibility import PlanarPatch, visible_planar_regions
+from tools.guala_body_optical_regime import BANDS, LIMITS, ORIGIN, retinal_apertures, scene
+
+
+QUAD = np.array(((-1., -1.), (1., -1.), (1., 1.), (-1., 1.)))
+BOUNDS = dict(max_vertices=32768, max_work=1048576)
+CELLS = 32768
+
+
+def panel(x, half_y, half_z, y=0., z=0.):
+    return PlanarPatch(np.array((x, y, z)), np.array(((0., half_y, 0.), (0., 0., half_z))), QUAD)
+
+
+def radiance(patches, colors, sites):
+    regions = visible_planar_regions(patches, **BOUNDS)
+    image = np.zeros((len(sites), 6))
+    for region in regions:
+        patch = patches[region.patch_index]
+        area = aperture_solid_angles(surface_cone(patch.points(region.boundary_uv)), sites, max_cells=CELLS)
+        image += area[:, None] * colors[region.patch_index]
+    omega = (sites[:, 1] - sites[:, 0]) * (sites[:, 3] - sites[:, 2])
+    return image / omega[:, None], regions
+
+
+def native_box_patches(engine, state):
+    """This bench reads only its three declared boxes; native rays see all geoms.
+
+    Returning source-local UV axes preserves the material chart. No second
+    scene/model is created, and no curved native geometry is claimed rendered.
+    """
+    observation = engine.observe(state)
+    head = next(f for f in observation.world_frames if f.name == "guala/head")
+    rotation = np.array(head.rotation_world).reshape(3, 3)
+    eye = np.array(head.position_m) + rotation @ ORIGIN
+    patches, ids, colors = [], [], []
+    for name, color in (("dark-panel", np.zeros(6)), ("emissive-panel", BANDS),
+                        ("occluder", BANDS[::-1].copy())):
+        geom = engine.geom_names.index(name)
+        size = engine._model.geom_size[geom]
+        centre = engine._data.geom_xpos[geom]
+        frame = engine._data.geom_xmat[geom].reshape(3, 3)
+        eye_local = frame.T @ (eye - centre)
+        for axis in range(3):
+            others = [i for i in range(3) if i != axis]
+            for sign in (-1, 1):
+                if sign * eye_local[axis] <= size[axis]:
+                    continue
+                origin = (centre + frame[:, axis] * sign * size[axis] - eye) @ rotation
+                axes = np.array([frame[:, a] * size[a] for a in others]) @ rotation
+                patches.append(PlanarPatch(origin, axes, QUAD))
+                ids.append(geom)
+                colors.append(color)
+    return tuple(patches), ids, colors
+
+
+class FunctionalBodyVisibilityTests(unittest.TestCase):
+    def test_occlusion_area_not_centre_sorting_and_permutation(self):
+        sites = retinal_apertures()
+        near, far = panel(1., .1, .1), panel(2., .8, .8)
+        colors = (BANDS, BANDS[::-1].copy())
+        actual, _ = radiance((near, far), colors, sites)
+        omega = (sites[:, 1] - sites[:, 0]) * (sites[:, 3] - sites[:, 2])
+        a = aperture_solid_angles(surface_cone(near.points(QUAD)), sites, max_cells=CELLS)
+        b = aperture_solid_angles(surface_cone(far.points(QUAD)), sites, max_cells=CELLS)
+        expected = (a[:, None] * colors[0] + (b-a)[:, None] * colors[1]) / omega[:, None]
+        np.testing.assert_allclose(actual, expected, atol=1e-10, rtol=0)
+        reverse, _ = radiance((far, near), colors[::-1], sites)
+        np.testing.assert_allclose(actual, reverse, atol=1e-10, rtol=0)
+
+        # Two physical planes cross: each is nearest on one side. Neither
+        # a global centre ordering nor alpha coverage can produce this split.
+        left = PlanarPatch(np.array((2., 0., 0.)), np.array(((.4, .8, 0.), (0., 0., .8))), QUAD)
+        right = PlanarPatch(np.array((2., 0., 0.)), np.array(((-.4, .8, 0.), (0., 0., .8))), QUAD)
+        _, regions = radiance((left, right), colors, sites[135:])
+        for region in regions:
+            points = (left, right)[region.patch_index].points(region.boundary_uv)
+            if region.patch_index == 0:
+                self.assertLessEqual(float(points[:, 1].max()), 1e-14)
+            else:
+                self.assertGreaterEqual(float(points[:, 1].min()), -1e-14)
+
+    def test_native_visibility_head_motion_and_cold_successor(self):
+        xml, _ = scene(.117, None)
+        root = ET.fromstring(xml)
+        ET.SubElement(root.find("worldbody"), "geom", name="occluder", type="box",
+                      pos="1.2 0 0.96", size=".02 .15 .15", euler=".13 -.11 .21")
+        xml = ET.tostring(root, encoding="unicode")
+        engine = NativeBody(xml, LIMITS, sensory_root="guala/pelvis")
+        initial = engine.initial_state()
+        updates = tuple(sorted((engine.actuator_names.index(name), value) for name, value in (
+            ("guala/head/roll/effort", .02), ("guala/head/pitch/effort", .015),
+            ("guala/head/yaw/effort", -.01))))
+        moved = engine.advance(initial, None, 50000, 1., effort_updates=updates).state
+        rays = np.array([(math.cos(v)*math.cos(h), math.cos(v)*math.sin(h), math.sin(v))
+                         for v in np.radians(np.linspace(-10.33, 10.33, 8))
+                         for h in np.radians(np.linspace(-12.37, 12.37, 10))])
+        images = []
+        for state in (initial, moved):
+            patches, ids, colors = native_box_patches(engine, state)
+            before = engine.observe(state)
+            started = time.perf_counter()
+            image, regions = radiance(patches, colors, retinal_apertures())
+            print(f"native_planar_visibility patches={len(patches)} fragments={len(regions)} "
+                  f"seconds={time.perf_counter()-started:.9f}", flush=True)
+            images.append(image)
+            hits = engine.ray_geometry(state, "guala/head", ORIGIN, rays, max_rays=len(rays))
+            coverage = np.zeros(len(rays), dtype=np.int64)
+            chosen = np.full(len(rays), -1, dtype=np.int64)
+            for region in regions:
+                p = patches[region.patch_index]
+                cone = surface_cone(p.points(region.boundary_uv))
+                inside = np.all(rays @ cone.T > 0, axis=1)
+                coverage += inside
+                chosen[inside] = ids[region.patch_index]
+            np.testing.assert_array_equal(coverage, 1)
+            np.testing.assert_array_equal(chosen, hits.geom_indices)
+            self.assertEqual(engine.observe(state), before)
+            fresh = NativeBody(xml, LIMITS, sensory_root="guala/pelvis")
+            cold_patches, _, cold_colors = native_box_patches(fresh, state)
+            cold_image, _ = radiance(cold_patches, cold_colors, retinal_apertures())
+            np.testing.assert_array_equal(image, cold_image)
+            self.assertEqual(engine.advance(state, None, 1000, 1.), fresh.advance(state, None, 1000, 1.))
+        self.assertGreater(float(np.max(np.abs(images[0] - images[1]))), 1/255)
+
+    def test_attached_material_coordinates_and_common_rotation(self):
+        # Two coplanar, adjacent material regions on one surface. A blocker
+        # cuts through both. UV remains fixed on the original physical plane.
+        left_uv = np.array(((-1., -1.), (0., -1.), (0., 1.), (-1., 1.)))
+        right_uv = np.array(((0., -1.), (1., -1.), (1., 1.), (0., 1.)))
+        base = panel(2., .4, .3)
+        patches = (PlanarPatch(base.origin, base.axes, left_uv),
+                   PlanarPatch(base.origin, base.axes, right_uv), panel(1., .1, .1))
+        before = tuple((p.origin.copy(), p.axes.copy(), p.boundary_uv.copy()) for p in patches)
+        regions = visible_planar_regions(patches, **BOUNDS)
+        a = .23
+        rotation = np.array(((1., 0., 0.), (0., math.cos(a), -math.sin(a)),
+                             (0., math.sin(a), math.cos(a))))
+        rotated = tuple(PlanarPatch(p.origin @ rotation.T, p.axes @ rotation.T, p.boundary_uv) for p in patches)
+        changed = visible_planar_regions(rotated, **BOUNDS)
+        # Compare per-material physical area; pieces may be split differently
+        # by floating arithmetic, but may not change material ownership.
+        for i, patch in enumerate(patches):
+            def uv_area(parts):
+                total = 0.
+                for r in parts:
+                    if r.patch_index != i:
+                        continue
+                    q = r.boundary_uv
+                    total += abs(float(np.sum(q[:,0]*np.roll(q[:,1], -1)-q[:,1]*np.roll(q[:,0], -1)))) / 2
+                    self.assertFalse(q.flags.writeable)
+                    self.assertTrue(np.all(q >= patch.boundary_uv.min(axis=0)-1e-14))
+                    self.assertTrue(np.all(q <= patch.boundary_uv.max(axis=0)+1e-14))
+                return total
+            self.assertAlmostEqual(uv_area(regions), uv_area(changed), places=12)
+            for actual, original in zip((patch.origin, patch.axes, patch.boundary_uv), before[i]):
+                np.testing.assert_array_equal(actual, original)
+
+    def test_collinear_material_boundary_and_finite_overflow(self):
+        p = panel(2., .4, .3)
+        redundant = PlanarPatch(p.origin, p.axes, np.array((
+            (-1., -1.), (0., -1.), (1., -1.), (1., 1.), (-1., 1.))))
+        blocker = panel(1., .1, .1)
+        sites = retinal_apertures()
+        expected, _ = radiance((p, blocker), (BANDS, BANDS[::-1]), sites)
+        actual, regions = radiance((redundant, blocker), (BANDS, BANDS[::-1]), sites)
+        np.testing.assert_allclose(actual, expected, atol=1e-12, rtol=0)
+        for region in regions:
+            # The downstream aperture boundary must accept every clipped piece.
+            owner = (redundant, blocker)[region.patch_index]
+            self.assertTrue(np.isfinite(surface_cone(owner.points(region.boundary_uv))).all())
+        crossing = PlanarPatch(np.array((0., 1., 0.)),
+                               np.array(((1e308, 0., 0.), (0., 0., 1.))), QUAD)
+        with np.errstate(over="ignore", invalid="ignore"):
+            visible = visible_planar_regions((crossing,), **BOUNDS)
+        self.assertEqual(len(visible), 1)
+        self.assertTrue(np.isfinite(visible[0].boundary_uv).all())
+        self.assertTrue(np.all(crossing.points(visible[0].boundary_uv)[:, 0] >= 0))
+        bad = PlanarPatch(p.origin, p.axes, QUAD * 1e200)
+        with np.errstate(over="ignore", invalid="ignore"), self.assertRaises(ValueError):
+            visible_planar_regions((bad,), **BOUNDS)
+        # Geometry preparation, not just clipping, consumes the stated budget.
+        with self.assertRaisesRegex(ValueError, "work"):
+            visible_planar_regions((p,), max_vertices=100, max_work=30)
+
+    def test_forward_crossing_empty_ambiguity_and_work_refusal(self):
+        crossing = PlanarPatch(np.array((0., 1., 0.)), np.array(((1., 0., 0.), (0., 0., 1.))), QUAD)
+        regions = visible_planar_regions((crossing,), **BOUNDS)
+        self.assertEqual(len(regions), 1)
+        self.assertTrue(np.all(crossing.points(regions[0].boundary_uv)[:, 0] >= 0))
+        self.assertEqual(visible_planar_regions((panel(-2., .1, .1),), **BOUNDS), ())
