+        for name in object_map.values():
+            roots[name] = int(mj.mj_name2id(m, mj.mjtObj.mjOBJ_BODY, name))
+        if any(i <= 0 for i in roots.values()):
+            raise ValueError("every entity needs an existing non-world native rigid frame")
