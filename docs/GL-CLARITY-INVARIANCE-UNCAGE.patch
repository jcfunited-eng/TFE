# Add these methods to Needs class (after most_unmet, around line 425):
    def update_arousal_direction(self, signed):
        """Set approach/withdraw bias. Clamped to [-1, 1].
        +1 = pull toward (curiosity/excitement/anger toward target)
        -1 = pull away (fear/anxiety/aversion)
         0 = no directional pull"""
        self.arousal_direction = max(-1.0, min(1.0, signed))

    def register_activity_start(self, target_need):
        """Snapshot need state when an activity begins."""
        self._activity_snapshot = {
            "stability": self.stability,
            "novelty": self.novelty,
            "connection": self.connection,
            "target": target_need,
        }

    def register_activity_end(self):
        """Check if the activity dropped its target need.
        If not, accumulate frustration. Returns delta (0 if successful)."""
        if not self._activity_snapshot:
            return 0.0
        target = self._activity_snapshot.get("target")
        if target in ("stability", "novelty", "connection"):
            before = self._activity_snapshot[target]
            after = getattr(self, target)
            if after >= before - 0.005:   # need didn't drop = blocked
                self.frustration = min(1.0, self.frustration + 0.1)
                self._activity_snapshot = None
                return 0.1
            else:
                self.frustration *= 0.9   # successful drop relaxes frustration
        self._activity_snapshot = None
        return 0.0

    def need_pressure(self):
        """Aggregate magnitude of unmet need. Used as affect input to record()."""
        gap = sum(max(0, self.TARGETS[k] - getattr(self, k)) for k in self.TARGETS)
        return min(1.0, gap / len(self.TARGETS) * 2)

