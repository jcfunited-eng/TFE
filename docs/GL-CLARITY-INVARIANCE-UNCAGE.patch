    def _compute_surprise(self, target_section, target_motif, predicted_invariant):
        """Surprise = gap between cortex-primed prediction and what just committed.
        predicted_invariant: dict from deep_atlas.get_invariant() for the priming chi.
        target_section/motif: what actually committed.
        Returns [0, 1]."""
        if not predicted_invariant:
            return 0.0
        actual_key = f"{target_section}|{target_motif}"
        if actual_key in predicted_invariant:
            # The thing that committed was anticipated by cortex — low surprise
            top_weight = max(predicted_invariant.values()) if predicted_invariant else 1.0
            anticipation = predicted_invariant[actual_key] / max(top_weight, 1e-6)
            return max(0.0, 1.0 - anticipation)
        # The thing that committed was NOT in the cortex prediction — high surprise
        return 1.0

