    def _emit_from_invariants(self, input_chis, input_words):
        """Compose emission via cortex co-occurrence invariants.
        Variable length. No fixed slot order. Driven by what cortex has
        invariantly learned to compose together."""
        if not input_chis:
            return None
        input_words_lower = set(w.lower() for w in input_words if w)

        # Find cortex entries primed by input (band-expanded)
        primed = []
        band = self.atlas.band
        for chi in input_chis:
            for d in range(-band, band + 1):
                for de in self.deep_atlas.entries.get(chi + d, []):
                    if de["strength"] >= 0.02:
                        primed.append(de)
        if not primed:
            return None

        # Aggregate co-occurrence weights, weighted by cortex strength × clarity
        # (vivid memories prime stronger — clarity matters for emission selection)
        comp = {}
        for de in primed:
            cl = de.get("clarity", de["strength"])
            prime = de["strength"] * cl
            for key, w in de.get("co_occurrence", {}).items():
                comp[key] = comp.get(key, 0.0) + w * prime
        if not comp:
            return None

        # Resolve (section, motif) keys to words; filter input echoes
        candidates = []
        for key, weight in comp.items():
            parts = key.split("|")
            if len(parts) != 2:
                continue
            try:
                section, motif = parts[0], int(parts[1])
            except (ValueError, KeyError):
                continue
            sec = self.sections.get(section)
            if not sec or motif >= len(sec.modes):
                continue
            _, _, word = sec.modes[motif]
            if not word or word.lower() in input_words_lower:
                continue
            candidates.append((word, section, weight))
        if not candidates:
            return None

        # Top candidates by relative weight threshold
        candidates.sort(key=lambda x: -x[2])
        top = candidates[0][2]
        REL_THRESH = 0.3
        MAX_LEN = 8
        selected = [c for c in candidates if c[2] >= top * REL_THRESH][:MAX_LEN]

        # Soft ordering by section role (NOT a slot lock — just readability)
        SEC_ORDER = {"intro": 0, "subject": 1, "verb": 2, "object": 3,
                     "listen": 4, "ground": 5, "sight": 6}
        selected.sort(key=lambda c: (SEC_ORDER.get(c[1], 99), -c[2]))

        # Renew clarity on every binding consumed by emission
        for word, section, _ in selected:
            sec = self.sections.get(section)
            if sec:
                for i, (_, _, w) in enumerate(sec.modes):
                    if w and w.lower() == word.lower():
                        for chi in input_chis:
                            self.atlas.renew_clarity(section, i, chi)
                        break

        # Dedup preserving order
        seen = set()
        out = []
        for word, _, _ in selected:
            if word.lower() not in seen:
                out.append(word)
                seen.add(word.lower())
        return " ".join(out) if out else None

    def _emit_unslotted(self, input_chis, input_words):
        """Fallback: variable-length composition from working-atlas chi-proximity.
        Not slot-locked. Uses real chi-bindings; cage removed."""
        from collections import Counter
        if not input_chis:
            return None
        input_words_lower = set(w.lower() for w in input_words if w)

        # Find chi positions where input content words are bound
        content_words = set()
        function_words = {"a", "an", "the", "is", "are", "am", "was", "were",
                          "of", "in", "on", "at", "to", "from", "with", "for",
                          "and", "or", "but", "me", "you", "i", "we", "they"}
        for w in input_words:
            if w and w.lower() not in function_words and len(w) > 1:
                content_words.add(w.lower())
        if not content_words:
            content_words = set(w.lower() for w in input_words if w)
        if not content_words:
            return None

        anchor_chis = set()
        for chi_k, entries in self.atlas.entries.items():
            for e in entries:
                if e["strength"] < 0.02:
                    continue
                sec = self.sections.get(e["section"])
                if sec and e["motif"] < len(sec.modes):
                    _, _, mw = sec.modes[e["motif"]]
                    if mw and mw.lower() in content_words:
                        anchor_chis.add(chi_k)

        if not anchor_chis:
            return None

        # Collect ALL bindings at anchor chis (no section filter — uncaged)
        # Weighted by strength × clarity
        weighted = {}
        for chi_k in anchor_chis:
            for e in self.atlas.entries.get(chi_k, []):
                if e["strength"] < 0.02:
                    continue
                sec = self.sections.get(e["section"])
                if not sec or e["motif"] >= len(sec.modes):
                    continue
                _, _, word = sec.modes[e["motif"]]
                if not word or word.lower() in input_words_lower:
                    continue
                cl = e.get("clarity", e["strength"])
                key = (word, e["section"])
                weighted[key] = weighted.get(key, 0.0) + e["strength"] * cl

        if not weighted:
            return None

        # Top by weight, variable length
        sorted_items = sorted(weighted.items(), key=lambda kv: -kv[1])
        if not sorted_items:
            return None
        top_w = sorted_items[0][1]
        REL = 0.3
        MAX_LEN = 8
        selected = [(k, w) for k, w in sorted_items if w >= top_w * REL][:MAX_LEN]

        # Soft section-role ordering
        SEC_ORDER = {"intro": 0, "subject": 1, "verb": 2, "object": 3,
                     "listen": 4, "ground": 5, "sight": 6}
        selected.sort(key=lambda kv: (SEC_ORDER.get(kv[0][1], 99), -kv[1]))

        seen = set()
        out = []
        for (word, _), _ in selected:
            if word.lower() not in seen:
                out.append(word)
                seen.add(word.lower())
        return " ".join(out) if out else None

