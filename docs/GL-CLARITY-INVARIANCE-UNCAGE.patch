+    def _update_invariant(self, deep_entry, observed_co):
+        """Apply the 0.92/0.08 averaging rule to co-occurrence invariants.
+        Observed co-occurrences grow slowly toward steady-state weight;
+        unobserved ones decay slowly (asymmetric, same 0.92 multiplier)."""
