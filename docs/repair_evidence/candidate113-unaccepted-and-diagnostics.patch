+/// Whether this currently energized layer-6 integration belongs to mounted
+/// auditory receptor anatomy.
+fn integration_carries_sound_source(
+    cohorts: &[ResidentReachedCohort],
+    topology: &ResidentTopologyIndex,
+    integration: [u8; 16],
+) -> Result<bool, FormationError> {
+    let integration_flat = topology.flat_for_lineage(integration)?;
+    for contact_index in topology.incident_contacts_by_flat[integration_flat]
+        .iter()
+        .copied()
+    {
+        let contact = topology.contacts[contact_index];
+        if !matches!(contact.origin, ResidentContactOrigin::Fabric { .. }) {
+            continue;
+        }
+        let source_flat = if contact.left == integration_flat {
+            contact.right
+        } else {
+            contact.left
+        };
+        let (cohort_index, neuron_index, _) = topology.flat_locations[source_flat];
+        if cohorts[cohort_index].anatomy.mounts()[neuron_index]
+            .source_site()
+            .is_some_and(|site| site.sense() == PhysicalSourceSense::Sound)
+        {
+            return Ok(true);
+        }
+    }
+    Ok(false)
+}
