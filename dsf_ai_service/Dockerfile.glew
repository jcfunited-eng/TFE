FROM python:3.11.14-slim-bookworm@sha256:65a93d69fa75478d554f4ad27c85c1e69fa184956261b4301ebaf6dbb0a3543d

ARG GIT_SHA=unknown
ARG BUILD_TS=unknown
LABEL org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.created="${BUILD_TS}" \
      com.gualaloom.runtime="glew-upstream-v1"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    GLEW_PROFILE_PATH=/app/dsf_ai_service/glew_runtime/GLEW_UPSTREAM_PROFILE_v1.json \
    GLEW_CREATE_CLEAN_GENESIS=0

WORKDIR /app

COPY dsf_ai_service/glew_runtime_requirements.lock /tmp/glew_runtime_requirements.lock
RUN python -m pip install --no-cache-dir --only-binary=:all: --require-hashes \
      -r /tmp/glew_runtime_requirements.lock \
    && python -c "import importlib.metadata as m, flint; assert m.version('fastapi') == '0.139.0'; assert m.version('uvicorn') == '0.50.0'; assert m.version('python-flint') == '0.9.0'; assert flint.__FLINT_VERSION__ == '3.6.0'; assert flint.ctx.threads == 1"

COPY dsf_ai_service/__init__.py /app/dsf_ai_service/__init__.py
COPY dsf_ai_service/substrate/__init__.py /app/dsf_ai_service/substrate/__init__.py
COPY dsf_ai_service/substrate/immutable_generation_store.py /app/dsf_ai_service/substrate/immutable_generation_store.py
COPY dsf_ai_service/glew_runtime/ /app/dsf_ai_service/glew_runtime/

RUN test ! -e /app/dsf_ai_service/app.py \
    && test ! -e /app/dsf_ai_service/substrate_runner.py \
    && python -c "from dsf_ai_service.glew_runtime.service import app; assert app.title == 'GLEW Runtime Visibility'"

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD python -c "import json,urllib.request; r=json.load(urllib.request.urlopen('http://127.0.0.1:8080/glew/status', timeout=5)); assert r['conformant'] is True"

CMD ["uvicorn", "dsf_ai_service.glew_runtime.service:app", "--host", "0.0.0.0", "--port", "8080"]
